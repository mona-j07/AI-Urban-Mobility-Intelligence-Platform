# ============================================================
# AI Urban Mobility — Environment Variables
# Copy this file and fill in real values per service.
# ============================================================

# -----------------------------------------------------------
# apps/web/.env.local
# -----------------------------------------------------------

# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Supabase anonymous / public key (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenRouteService API key (openrouteservice.org/dev)
NEXT_PUBLIC_MAP_API_KEY=your-ors-api-key

# FastAPI AI engine URL (local dev: http://localhost:8000)
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# -----------------------------------------------------------
# services/ai/.env
# -----------------------------------------------------------

# Supabase project URL
SUPABASE_URL=https://xxxx.supabase.co

# Supabase service-role / secret key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouteService API key
MAP_API_KEY=your-ors-api-key

# Anthropic API key (console.anthropic.com)
AI_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------
# services/simulator/.env
# -----------------------------------------------------------

# (uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from above)
